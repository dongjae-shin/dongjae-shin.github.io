{% assign github_user = site.data.repositories.github_user_metadata | where: 'username', include.username | first %}
{% assign user_name = github_user.name | default: include.username %}
{% assign user_bio = github_user.bio | default: 'GitHub user' %}
{% assign user_location = github_user.location %}
{% assign user_repos = github_user.public_repos %}
{% assign user_followers = github_user.followers %}

<div class="repo repo-user p-2">
  <a class="repo-user-card" href="https://github.com/{{ include.username }}">
    <img
      class="repo-user-avatar"
      alt="{{ include.username }}"
      src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png"
      loading="lazy"
    >
    <div class="repo-user-body">
      <div class="repo-user-name">{{ user_name }}</div>
      <div class="repo-user-username">@{{ include.username }}</div>
      <p class="repo-user-bio">{{ user_bio }}</p>
      <div class="repo-user-meta">
        {% if user_location %}
          <span><i class="fa-solid fa-location-dot"></i> {{ user_location }}</span>
        {% endif %}
        {% if user_repos %}
          <span><i class="fa-solid fa-code-branch"></i> {{ user_repos }} repos</span>
        {% endif %}
        {% if user_followers %}
          <span><i class="fa-solid fa-user-group"></i> {{ user_followers }} followers</span>
        {% endif %}
      </div>
    </div>
  </a>
</div>
